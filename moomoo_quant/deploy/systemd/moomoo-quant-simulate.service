[Unit]
Description=Moomoo Quant SIMULATE Observer and Signal Rebalancer
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=120
User=moomooquant
Group=moomooquant
WorkingDirectory=/opt/stacks/moomoo-quant
Environment=MOOMOO_QUANT_DATA_ROOT=/opt/data/moomoo-quant
Environment=HOME=/opt/data/moomoo-quant
Environment=PYTHONUNBUFFERED=1
Environment=QUANT_ADMIN_MODE=false
Environment=QUANT_KILL_SWITCH=true
EnvironmentFile=/etc/moomoo-quant/simulate.env
ExecStart=/opt/stacks/moomoo-quant/.venv/bin/python -m moomoo_quant.jobs.simulate_runner --auto
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/data/moomoo-quant

